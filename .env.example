# Local PostgreSQL connection. Create the database "gradlink_zw" first.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gradlink_zw
PORT=3001
PG_POOL_MAX=10

# Only needed when creating the first admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=GradLink Administrator
