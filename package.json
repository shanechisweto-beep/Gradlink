{
  "name": "gradlink-zw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "start": "tsx server/index.ts",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview",
    "db:migrate": "tsx server/migrate.ts",
    "admin:create": "tsx server/create-admin.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
